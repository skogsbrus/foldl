[17.181, "o", "foldl: allowed ~/svc\r\nfoldl: parity: direnv and foldl export the same environment\r\nfoldl: ran direnv deny (local to you; .envrc stays for others)\r\nfoldl: imported ~/svc/.envrc into 2 migrations; they load at the next prompt\r\n"]
[17.194, "o", "foldl \u2191 env (+2 vars) \u00b7 dotenv (+1 var)\r\n"]
