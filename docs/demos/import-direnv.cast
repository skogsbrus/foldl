[11.469, "o", "==> .foldl/001-env/manifest.toml\r\nversion = 1\r\npath_add = [\"bin\"]\r\n\r\n[env]\r\nDATABASE_URL = \"postgres://localhost/svc\"\r\n==> .foldl/002-dotenv/manifest.toml\r\nversion = 1\r\nbuiltin = \"dotenv\"\r\n\r\n[builtin_options]\r\nfile = \".env\"\r\n"]
